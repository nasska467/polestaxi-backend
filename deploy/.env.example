# Shared
HTTP_ADDR=http://localhost:8080
GRPC_ADDR=localhost:9090
SEED=false

# User / Driver
MONGO_CONNECTION=mongodb://127.0.0.1:27018
MONGO_USER_DATABASE=polestaxi_users
MONGO_DRIVER_DATABASE=polestaxi_drivers

# Auth / caches
REDIS_CONNECTION=127.0.0.1:16379
ACCESS_TTL_SECONDS=1200
REFRESH_TTL_SECONDS=1209600

# Wallet
POSTGRES_CONNECTION=Host=127.0.0.1;Port=15432;Database=polestaxi_wallet;Username=polestaxi;Password=polestaxi

# Order
ELASTICSEARCH_URI=http://127.0.0.1:9200
ELASTICSEARCH_INDEX=orders

# Analytic
CLICKHOUSE_CONNECTION=Host=127.0.0.1;Port=8123;Database=default;Username=default;Password=

# Kafka
KAFKA_BROKERS=127.0.0.1:9092